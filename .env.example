# Coming-soon gate.
#   true  -> every visitor is redirected to /coming-soon
#   false -> the real site shows (any value other than "true" behaves this way)
NEXT_PUBLIC_COMING_SOON=false

# The site's public address, used for link previews.
# Leave unset locally; set this in Vercel to the real domain.
# NEXT_PUBLIC_SITE_URL=https://amremad.com
